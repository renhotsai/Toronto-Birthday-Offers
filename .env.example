# Postgres connection string (Neon: use the pooled connection string, with sslmode=require)
DATABASE_URL=postgres://postgres@127.0.0.1:5433/tbo

# Better Auth: a long random string (e.g. `openssl rand -base64 32`) and the public site URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails that become admins on first sign-in
ADMIN_EMAILS=you@example.com

# Google sign-in (optional; the button only shows when both are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email via Resend (optional locally: links are printed to the server log instead)
RESEND_API_KEY=
EMAIL_FROM=Toronto Birthday Offers <hello@yourdomain.com>

# Only for `npm test` database tests (a disposable database; it gets wiped)
TEST_DATABASE_URL=
